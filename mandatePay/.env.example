# Razorpay TEST MODE credentials.
#
# Copy this file to `.env` and fill in the values locally.
# `.env` is gitignored and must NEVER be committed.
#
# Variable NAMES only below -- no values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI buyer agent -- OpenAI (official Python SDK).
#
# Variable NAMES only below -- no values.
# Without these the /app/v1/agent/purchase endpoint fails with an explicit
# configuration error rather than pretending an AI ran.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. Leave blank unless pointing at an OpenAI-compatible endpoint.
OPENAI_BASE_URL=
